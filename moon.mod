// MoonDiff 模块元数据
// 文档：https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "wuhaiting321/moondiff"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/wuhaiting321/MoonDiff"

license = "Apache-2.0"

keywords = [
  "differential-testing",
  "wasm",
  "wasm-gc",
  "cross-backend",
  "testing",
  "verification",
]

preferred_target = "wasm"

description = "MoonDiff：MoonBit 跨后端一致性差分验证框架。同一份规格程序在 wasm / wasm-gc / js / native 上执行，逐位比对转录，自动收缩最小反例。"
